{
  "name": "coquette-demo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "node e2e/demo.e2e.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:seed": "node scripts/db-seed.mts",
    "test:e2e:salon": "node e2e/salon.e2e.mjs",
    "test:e2e:clientes": "node e2e/clientes.e2e.mjs",
    "test:e2e:equipe": "node e2e/equipe-avis-videos.e2e.mjs",
    "vercel-build": "node scripts/db-migrate.mjs && next build"
  },
  "dependencies": {
    "@vercel/blob": "2.8.1",
    "next": "16.4.0",
    "postgres": "3.4.7",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jsdom": "^30.1.2",
    "playwright-core": "^1.64.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
