# Copier en .env.local (jamais commité) et remplir.
# Base PostgreSQL (Neon en production : chaîne « pooled »).
DATABASE_URL=postgres://postgres@127.0.0.1:5432/mia_dev
# Taille du pool de connexions (facultatif).
DATABASE_POOL_MAX=5
# Base de test : EFFACÉE à chaque lancement des tests d'intégration. Ne jamais pointer vers la production.
DATABASE_URL_TEST=postgres://postgres@127.0.0.1:5432/mia_test

# Acompte en ligne (PayDunya). Sans ces variables, la fonction est éteinte. Mettre les VRAIES valeurs dans .env.local uniquement.
# Clé principale, clé privée et token : en mode test, prendre ceux de l'onglet « test » de l'application PayDunya.
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
# Montant de l'acompte en FCFA (500 à 100000).
ACOMPTE_FCFA=
# « production » seulement pour de vrais paiements ; sinon (ou vide) = mode test, aucun argent réel.
PAYDUNYA_MODE=
# Adresse publique du site (facultatif, ex. https://mon-site.vercel.app) ; sinon déduite de la requête.
SITE_URL=
