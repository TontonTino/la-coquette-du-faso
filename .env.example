# Copier en .env.local (jamais commité) et remplir.
# Base PostgreSQL (Neon en production : chaîne « pooled »).
DATABASE_URL=postgres://postgres@127.0.0.1:5432/mia_dev
# Taille du pool de connexions (facultatif).
DATABASE_POOL_MAX=5
# Base de test : EFFACÉE à chaque lancement des tests d'intégration. Ne jamais pointer vers la production.
DATABASE_URL_TEST=postgres://postgres@127.0.0.1:5432/mia_test
